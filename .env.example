# =============================================
# Agentic GTBench — Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env to git
# =============================================

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-key-here

# ---- Anthropic (optional) ----
ANTHROPIC_API_KEY=

# ---- Groq (multiple keys for rate-limit rotation) ----
# Rotation is round-robin per PlayerAgent instantiation, so each game/round
# in an experiment will pick the next key. Add as many as you have.
# Either GROQ_API_KEY (single) or GROQ_API_KEYS (comma-separated) is also accepted.
GROQ_API_KEY_1=gsk_your-first-groq-key-here
GROQ_API_KEY_2=gsk_your-second-groq-key-here
GROQ_API_KEY_3=gsk_your-third-groq-key-here
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Optional: comma-separated list (used in addition to the numbered keys above).
# GROQ_API_KEYS=gsk_keyA,gsk_keyB,gsk_keyC

# Optional: legacy single-key fallback (used if no numbered/list keys are set).
# GROQ_API_KEY=gsk_your-groq-key-here

# ---- Model Defaults ----
# DEFAULT_PROVIDER picks which LLM backend PlayerAgent uses when a matchup
# config does not pin one explicitly. Valid: "groq" | "openai".
DEFAULT_PROVIDER=groq
DEFAULT_GROQ_MODEL=llama-3.1-8b-instant     # Free-tier friendly, fast
DEFAULT_OPENAI_MODEL=gpt-4o-mini            # Used only when provider=openai
DEFAULT_MODEL=llama-3.1-8b-instant          # Legacy alias — kept for back-compat
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=1024                     # Per GTBench paper §4
MAX_RETRIES=3                               # Max invalid move retries per turn

# ---- Paths ----
RESULTS_DIR=./results
LOG_DIR=./logs

# ---- Logging ----
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
