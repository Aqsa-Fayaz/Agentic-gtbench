# =============================================
# Agentic GTBench — Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env to git
# =============================================

# ---- LLM API Keys ----
# If you route all models through OpenRouter, set only OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_API_KEY_ALT=                    # Optional second key
OPENAI_API_KEY=sk-your-key-here            # Only for provider: openai (direct)
GROQ_API_KEY=gsk_your-groq-key-here        # Only for provider: groq (direct)
ANTHROPIC_API_KEY=                          # Optional

# ---- Model Defaults ----
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.3
MAX_RETRIES=3                               # Max invalid move retries per turn

# ---- Paths ----
RESULTS_DIR=./results
LOG_DIR=./logs

# ---- Logging ----
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
